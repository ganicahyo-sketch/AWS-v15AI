<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_root" android:paddingTop="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="10dp" android:paddingBottom="10dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STASIUN CUACA" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="18sp"/>
            <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MONITORING DATA THINGSPEAK" android:textColor="@color/cyan" android:textSize="10sp" android:letterSpacing="0.14"/>
        </LinearLayout>
        <TextView android:id="@+id/settings" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="⚙" android:textColor="@color/text_main" android:textSize="24sp" android:background="@drawable/bg_chip"/>
    </LinearLayout>

    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/statusChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="MENYIAPKAN" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="11sp" android:background="@drawable/bg_chip"/>
                    <TextView android:id="@+id/lastAccess" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Akses terakhir: --" android:textColor="@color/text_muted" android:textSize="11sp"/>
                </LinearLayout>
                <TextView android:id="@+id/deviceDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Hari, tanggal" android:textColor="@color/text_muted" android:textSize="12sp"/>
                <TextView android:id="@+id/deviceClock" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="00:00:00 WIB" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="26sp"/>
                <TextView android:id="@+id/dataTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Data ThingSpeak: --" android:textColor="@color/text_muted" android:textSize="11sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <TextView android:id="@+id/refresh" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:text="PERBARUI SEKARANG" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="11sp" android:background="@drawable/bg_button"/>
                    <Space android:layout_width="8dp" android:layout_height="1dp"/>
                    <TextView android:id="@+id/channelView" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:text="CHANNEL: --" android:textColor="@color/text_main" android:textSize="11sp" android:background="@drawable/bg_chip"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="7dp" android:text="DATA PENGUKURAN" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.12"/>
            <GridLayout android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:useDefaultMargins="false"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_panel" android:padding="14dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DATA CUACA MAKRO • OPENWEATHER" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.08"/>
                    <TextView android:id="@+id/weatherRefresh" android:layout_width="120dp" android:layout_height="38dp" android:gravity="center" android:text="PERBARUI" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="10sp" android:background="@drawable/bg_button"/>
                </LinearLayout>
                <TextView android:id="@+id/weatherStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="OPENWEATHER --" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="12sp"/>
                <TextView android:id="@+id/weatherLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="GPS HP: --" android:textColor="@color/text_muted" android:textSize="10sp"/>
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/weatherTemp" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Suhu --" android:textColor="@color/text_main" android:textSize="15sp"/>
                    <TextView android:id="@+id/weatherFeels" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Terasa --" android:textColor="@color/text_main" android:textSize="15sp"/>
                    <TextView android:id="@+id/weatherHumidity" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="RH --" android:textColor="@color/text_main" android:textSize="15sp"/>
                    <TextView android:id="@+id/weatherDew" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Titik embun --" android:textColor="@color/text_main" android:textSize="15sp"/>
                    <TextView android:id="@+id/weatherPressure" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Tekanan --" android:textColor="@color/text_main" android:textSize="15sp"/>
                    <TextView android:id="@+id/weatherCloud" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Awan --" android:textColor="@color/text_main" android:textSize="15sp"/>
                    <TextView android:id="@+id/weatherUv" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="UV --" android:textColor="@color/text_main" android:textSize="15sp"/>
                    <TextView android:id="@+id/weatherVisibility" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Visibilitas --" android:textColor="@color/text_main" android:textSize="15sp"/>
                    <TextView android:id="@+id/weatherWind" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Angin --" android:textColor="@color/text_main" android:textSize="14sp"/>
                    <TextView android:id="@+id/weatherWindDir" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Arah --" android:textColor="@color/text_main" android:textSize="15sp"/>
                    <TextView android:id="@+id/weatherRain" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Hujan --" android:textColor="@color/text_main" android:textSize="15sp"/>
                    <TextView android:id="@+id/weatherEt0" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="ET₀ --" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="15sp"/>
                </GridLayout>
                <TextView android:id="@+id/weatherCondition" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Kondisi: --" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="12sp"/>
                <TextView android:id="@+id/weatherSunrise" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Terbit --" android:textColor="@color/text_muted" android:textSize="10sp"/>
                <TextView android:id="@+id/weatherSunset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Terbenam --" android:textColor="@color/text_muted" android:textSize="10sp"/>
                <TextView android:id="@+id/weatherAlerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Peringatan: --" android:textColor="@color/text_muted" android:textSize="10sp"/>
                <TextView android:id="@+id/weatherForecast" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Prakiraan: --" android:textColor="@color/text_main" android:textSize="11sp" android:lineSpacingExtra="2dp"/>
                <TextView android:id="@+id/weatherUpdated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Pembaruan: --" android:textColor="@color/text_muted" android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_panel" android:padding="14dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SARAN AI UNTUK PETANI" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.12"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="AI membaca data cuaca terakhir dan memberi langkah yang mudah dipahami. AI tidak dipanggil otomatis." android:textColor="@color/text_muted" android:textSize="11sp"/>
                <TextView android:id="@+id/aiButton" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="10dp" android:gravity="center" android:text="BUAT SARAN DARI DATA TERBARU" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="11sp" android:background="@drawable/bg_button"/>
                <TextView android:id="@+id/aiStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="AI belum dijalankan" android:textColor="@color/text_muted" android:textSize="10sp"/>
                <TextView android:id="@+id/aiAdvice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Belum ada saran. Atur API key AI pada Pengaturan lalu tekan tombol di atas." android:textColor="@color/text_main" android:textSize="13sp" android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_panel" android:padding="14dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DATA EXPORT CSV" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.12"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Unduh data ThingSpeak berdasarkan rentang tanggal atau seluruh histori." android:textColor="@color/text_muted" android:textSize="11sp"/>
                <TextView android:id="@+id/downloadCsv" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="10dp" android:gravity="center" android:text="UNDUH DATA CSV" android:textColor="@color/navy_950" android:textStyle="bold" android:textSize="11sp" android:background="@drawable/bg_button"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_panel" android:padding="14dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STATUS" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.12"/>
                <TextView android:id="@+id/finalStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Menyiapkan koneksi ThingSpeak..." android:textColor="@color/text_main" android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
