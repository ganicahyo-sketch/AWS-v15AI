<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_root" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PENGATURAN" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="20sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Nama judul, nama field, satuan, jumlah angka desimal, dan AI dapat diatur di sini." android:textColor="@color/text_muted" android:textSize="12sp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="JUDUL TAMPILAN" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
        <EditText android:id="@+id/appTitle" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="STASIUN CUACA" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:singleLine="true"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="CHANNEL ID" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
        <EditText android:id="@+id/channel" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Contoh: 266256" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:inputType="number"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="READ API KEY" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:orientation="horizontal">
            <EditText android:id="@+id/readKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Read API Key (boleh kosong untuk channel publik)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:inputType="textPassword"/>
            <TextView android:id="@+id/toggleKey" android:layout_width="90dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:text="TAMPILKAN" android:textColor="@color/text_main" android:textSize="10sp" android:background="@drawable/bg_chip"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="ANGKA PADA LAYAR" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pilih jumlah angka di belakang koma. Maksimal 2 angka. Pengaturan ini hanya mengubah tampilan layar, bukan data asli ThingSpeak/CSV." android:textColor="@color/text_muted" android:textSize="11sp"/>
        <Spinner android:id="@+id/decimals" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/bg_edit"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="NAMA FIELD DAN SATUAN" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Nama field otomatis mengikuti ThingSpeak. Isi nama pengganti hanya bila ingin mengubah tampilan. Satuan selalu bisa disesuaikan." android:textColor="@color/text_muted" android:textSize="11sp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 1" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="11sp"/>
        <EditText android:id="@+id/fieldName1" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:hint="Nama tampilan (kosong = otomatis)"/>
        <EditText android:id="@+id/fieldUnit1" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan, contoh: °C / % / lux" android:textColorHint="@color/text_muted" android:textColor="@color/text_main"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 2" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="11sp"/>
        <EditText android:id="@+id/fieldName2" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:hint="Nama tampilan (kosong = otomatis)"/>
        <EditText android:id="@+id/fieldUnit2" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan" android:textColorHint="@color/text_muted" android:textColor="@color/text_main"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 3" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="11sp"/>
        <EditText android:id="@+id/fieldName3" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:hint="Nama tampilan (kosong = otomatis)"/>
        <EditText android:id="@+id/fieldUnit3" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan" android:textColorHint="@color/text_muted" android:textColor="@color/text_main"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 4" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="11sp"/>
        <EditText android:id="@+id/fieldName4" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:hint="Nama tampilan (kosong = otomatis)"/>
        <EditText android:id="@+id/fieldUnit4" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan" android:textColorHint="@color/text_muted" android:textColor="@color/text_main"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 5" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="11sp"/>
        <EditText android:id="@+id/fieldName5" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:hint="Nama tampilan (kosong = otomatis)"/>
        <EditText android:id="@+id/fieldUnit5" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan" android:textColorHint="@color/text_muted" android:textColor="@color/text_main"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 6" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="11sp"/>
        <EditText android:id="@+id/fieldName6" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:hint="Nama tampilan (kosong = otomatis)"/>
        <EditText android:id="@+id/fieldUnit6" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan" android:textColorHint="@color/text_muted" android:textColor="@color/text_main"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 7" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="11sp"/>
        <EditText android:id="@+id/fieldName7" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:hint="Nama tampilan (kosong = otomatis)"/>
        <EditText android:id="@+id/fieldUnit7" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan" android:textColorHint="@color/text_muted" android:textColor="@color/text_main"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FIELD 8" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="11sp"/>
        <EditText android:id="@+id/fieldName8" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:hint="Nama tampilan (kosong = otomatis)"/>
        <EditText android:id="@+id/fieldUnit8" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Satuan" android:textColorHint="@color/text_muted" android:textColor="@color/text_main"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="OPENWEATHER • DATA MAKRO" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Digunakan untuk cuaca makro, arah/kecepatan angin, hujan, awan, prakiraan dan estimasi ET₀. Lokasi diambil otomatis dari GPS HP." android:textColor="@color/text_muted" android:textSize="11sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:orientation="horizontal">
            <EditText android:id="@+id/openWeatherKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="OpenWeather One Call API 4.0 Key" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:inputType="textPassword"/>
            <TextView android:id="@+id/toggleOpenWeatherKey" android:layout_width="90dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:text="TAMPILKAN" android:textColor="@color/text_main" android:textSize="10sp" android:background="@drawable/bg_chip"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="PENGATURAN AI" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Masukkan API key AI Anda. Key disimpan di perangkat ini. Untuk aplikasi produksi yang digunakan banyak orang, sebaiknya AI dipanggil melalui server perantara agar key tidak tertanam di aplikasi." android:textColor="@color/text_muted" android:textSize="11sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:orientation="horizontal">
            <EditText android:id="@+id/aiKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="OpenAI API key" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:inputType="textPassword"/>
            <TextView android:id="@+id/toggleAiKey" android:layout_width="90dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:text="TAMPILKAN" android:textColor="@color/text_main" android:textSize="10sp" android:background="@drawable/bg_chip"/>
        </LinearLayout>
        <EditText android:id="@+id/aiModel" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Model AI, contoh: gpt-6-luna" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:singleLine="true"/>
        <EditText android:id="@+id/crop" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Komoditas/tanaman, contoh: kelapa sawit" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:singleLine="true"/>

        <TextView android:id="@+id/save" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="22dp" android:gravity="center" android:text="SIMPAN" android:textColor="@color/navy_950" android:textStyle="bold" android:background="@drawable/bg_button"/>
        <TextView android:id="@+id/cancel" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center" android:text="BATAL" android:textColor="@color/text_main" android:background="@drawable/bg_chip"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="INFO APLIKASI" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.12"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Versi aplikasi: 1.4" android:textColor="@color/text_main" android:textSize="13sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Pembuat: Gani Cahyo H" android:textColor="@color/text_main" android:textSize="13sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Agroteknologi-Universitas Sebelas Maret" android:textColor="@color/text_muted" android:textSize="12sp"/>
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="12dp"/>
    </LinearLayout>
</ScrollView>
